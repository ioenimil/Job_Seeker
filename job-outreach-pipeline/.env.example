# API Keys for Lead Discovery & Enrichment
APIFY_API_TOKEN=your_apify_api_token_here
EXA_API_KEY=your_exa_api_key_here
HUNTER_API_KEY=your_hunter_api_key_here
PROSPEO_API_KEY=your_prospeo_api_key_here

# Sender Email Settings
SENDER_EMAIL=your_gmail_address_here@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Grounded LLM tailoring (optional; 'none' uses the deterministic per-type pitch)
LLM_PROVIDER=none            # none | anthropic | openai | ollama
LLM_MODEL=                   # anthropic defaults to claude-sonnet-5-5; required for openai/ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Database location (defaults to outreach.db next to the scripts)
# OUTREACH_DB=/path/to/outreach.db
